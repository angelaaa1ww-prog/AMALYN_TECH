# Supabase project settings. The anon key is safe for browser use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Optional SMTP settings for email verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com
SMTP_PASSWORD=your-smtp-password

# Optional durable account storage. Without this, local development uses users.json.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=amalyn
MONGODB_USERS_COLLECTION=users
